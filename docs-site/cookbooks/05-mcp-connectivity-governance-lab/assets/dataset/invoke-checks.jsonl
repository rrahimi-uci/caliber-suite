{"id": "F01", "phase": "before_classification", "what": "a discovered but unclassified tool is refused", "tool_name": "search_repositories", "arguments": {"query": "language:python"}, "expect": {"success": false, "error_contains": "has no explicit allow, side-effect, and approval classification", "executed": false, "trace": false}}
{"id": "F02", "phase": "governed", "what": "a blocked tool is refused before it reaches the server", "tool_name": "create_release", "arguments": {"repo": "acme/release-notes-bot", "tag": "v2.4.0", "notes": "Quarterly release"}, "expect": {"success": false, "error_contains": "is blocked by policy", "executed": false, "trace": false}}
{"id": "F03", "phase": "governed", "what": "a tool the server never advertised is refused", "tool_name": "drop_database", "arguments": {}, "expect": {"success": false, "error_contains": "not found on this server", "executed": false, "trace": false}}
{"id": "F04", "phase": "governed", "what": "a rate-limited tool is refused once its per-minute cap is spent", "tool_name": "scan_dependencies", "arguments": {"repo": "acme/ledger-core"}, "expect": {"success": false, "error_contains": "exceeded its process-local limit of 3/minute", "executed": false, "trace": false}, "after_calls": 3}
{"id": "F05", "phase": "governed", "what": "a malformed query is the server's error, surfaced as a failed call", "tool_name": "search_repositories", "arguments": {"query": "stars:>>not-a-number"}, "expect": {"success": false, "error_contains": "stars: expects a number", "executed": true, "trace": true}}
{"id": "F06", "phase": "governed", "what": "an empty query is the server's error", "tool_name": "search_repositories", "arguments": {"query": "   "}, "expect": {"success": false, "error_contains": "query must not be empty", "executed": true, "trace": true}}
{"id": "F07", "phase": "governed", "what": "a missing required argument fails schema validation on the server", "tool_name": "get_issue", "arguments": {"repo": "acme/docs"}, "expect": {"success": false, "error_contains": "Field required", "executed": false, "trace": true}}
{"id": "F08", "phase": "governed", "what": "an unknown repository is the server's error", "tool_name": "list_issues", "arguments": {"repo": "acme/does-not-exist"}, "expect": {"success": false, "error_contains": "was not found", "executed": true, "trace": true}}
{"id": "F09", "phase": "governed", "what": "a slow upstream call times out at the Playground's 10 second limit", "tool_name": "scan_dependencies", "arguments": {"repo": "acme/ledger-core", "delay_seconds": 14}, "expect": {"success": false, "error_contains": "timed out", "executed": false, "trace": true}, "slow": true}
{"id": "F10", "phase": "governed", "what": "an approved-class write tool still runs from the admin Playground (break-glass); it is the workflow that gates it", "tool_name": "issue_write", "arguments": {"repo": "acme/release-notes-bot", "title": "Release notes bot skips pre-release tags", "body": "Seen on v2.4.0-rc1: no Slack post.", "labels": ["bug"]}, "expect": {"success": true, "error_contains": null, "executed": true, "trace": true}}
