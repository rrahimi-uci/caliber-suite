{
  "schema_version": 1,
  "workflow_id": "WF-IMPORTED",
  "name": "incident-commander-lab",
  "description": "Cookbook 08: turn an incident record (alert, deployments, health, logs, signals) into a severity and the lowest-risk action, with rollback behind a human approval.",
  "runtime": {
    "sdk": "openai-agents-python",
    "sdk_version_policy": "runtime-pinned",
    "compiler_version": "caliber-workflow-compiler-v1",
    "default_model_ref": "CALIBER_WORKFLOW_DEFAULT_MODEL",
    "session": {
      "type": "none"
    }
  },
  "nodes": {
    "start": {
      "id": "start",
      "type": "start",
      "label": "Incident",
      "outputs": {
        "incident": {
          "type": "string"
        }
      }
    },
    "fan_out": {
      "id": "fan_out",
      "type": "parallel",
      "label": "Assess in parallel",
      "inputs": {
        "input": {
          "type": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "string"
        }
      }
    },
    "ingest": {
      "id": "ingest",
      "type": "data_transform",
      "label": "Normalize the incident",
      "operation": "mapping",
      "config": {
        "fields": {
          "incident_id": "incident.incident_id",
          "service": "incident.service",
          "environment": "incident.environment",
          "customer_impact": "incident.customer_impact",
          "alert_text": "incident.alert_text"
        },
        "defaults": {
          "service": "unknown",
          "environment": "unknown",
          "customer_impact": "unknown"
        }
      },
      "fail_on_invalid": true,
      "inputs": {
        "value": {
          "type": "structured"
        },
        "text": {
          "type": "string"
        }
      },
      "outputs": {
        "text": {
          "type": "string"
        },
        "result": {
          "type": "structured"
        },
        "valid": {
          "type": "boolean"
        },
        "metadata": {
          "type": "structured"
        }
      }
    },
    "draft_update": {
      "id": "draft_update",
      "type": "agent",
      "name": "incident-commander",
      "model": "inherit",
      "label": "Draft the stakeholder update (agent)",
      "instructions": {
        "type": "inline",
        "text": "You are the incident commander's scribe. From the incident record, write a three-sentence stakeholder update. State only what the evidence shows, label anything else as a hypothesis, never promise a resolution time, and never claim the incident is resolved."
      },
      "tools": [],
      "inputs": {
        "input": {
          "type": "string"
        },
        "history": {
          "type": "structured"
        }
      },
      "outputs": {
        "final_output": {
          "type": "string"
        },
        "history": {
          "type": "structured"
        }
      }
    },
    "severity_table": {
      "id": "severity_table",
      "type": "data_transform",
      "label": "Severity matrix",
      "operation": "decision_table",
      "config": {
        "rules": [
          {
            "name": "sev1-prod-total-outage",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.customer_impact",
                "operator": "equals",
                "value": "all"
              },
              {
                "path": "incident.evidence.health.error_rate",
                "operator": "greater_or_equal",
                "value": 0.1
              }
            ],
            "result": "sev1"
          },
          {
            "name": "sev1-prod-paging-storm",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.customer_impact",
                "operator": "equals",
                "value": "all"
              },
              {
                "path": "incident.evidence.signals.pager_alerts",
                "operator": "greater_or_equal",
                "value": 3
              }
            ],
            "result": "sev1"
          },
          {
            "name": "sev1-data-corruption",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.log_excerpt",
                "operator": "contains",
                "value": "DATA CORRUPTION"
              }
            ],
            "result": "sev1"
          },
          {
            "name": "sev2-elevated-errors",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.health.error_rate",
                "operator": "greater_or_equal",
                "value": 0.05
              }
            ],
            "result": "sev2"
          },
          {
            "name": "sev2-latency-breach",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.health.latency_p99_ms",
                "operator": "greater_or_equal",
                "value": 2000
              }
            ],
            "result": "sev2"
          },
          {
            "name": "sev2-partial-impact-degraded",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.customer_impact",
                "operator": "equals",
                "value": "partial"
              },
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "degraded"
              }
            ],
            "result": "sev2"
          },
          {
            "name": "sev3-prod-degraded",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "degraded"
              }
            ],
            "result": "sev3"
          },
          {
            "name": "sev3-prod-health-unknown",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "unknown"
              }
            ],
            "result": "sev3"
          },
          {
            "name": "sev3-prod-no-health-evidence",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.health.status",
                "operator": "exists",
                "value": false
              }
            ],
            "result": "sev3"
          },
          {
            "name": "sev3-prod-paged",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.signals.pager_alerts",
                "operator": "greater_or_equal",
                "value": 2
              }
            ],
            "result": "sev3"
          },
          {
            "name": "sev3-prod-customer-reports",
            "when": [
              {
                "path": "incident.environment",
                "operator": "equals",
                "value": "prod"
              },
              {
                "path": "incident.evidence.signals.status_page_reports",
                "operator": "greater_or_equal",
                "value": 1
              }
            ],
            "result": "sev3"
          }
        ],
        "default": "sev4"
      },
      "fail_on_invalid": true,
      "inputs": {
        "value": {
          "type": "structured"
        },
        "text": {
          "type": "string"
        }
      },
      "outputs": {
        "text": {
          "type": "string"
        },
        "result": {
          "type": "structured"
        },
        "valid": {
          "type": "boolean"
        },
        "metadata": {
          "type": "structured"
        }
      }
    },
    "action_table": {
      "id": "action_table",
      "type": "data_transform",
      "label": "Lowest-risk action",
      "operation": "decision_table",
      "config": {
        "rules": [
          {
            "name": "escalate-health-unknown-and-paging",
            "when": [
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "unknown"
              },
              {
                "path": "incident.evidence.signals.pager_alerts",
                "operator": "greater_or_equal",
                "value": 3
              }
            ],
            "result": "escalate_human"
          },
          {
            "name": "gather-health-unknown",
            "when": [
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "unknown"
              }
            ],
            "result": "gather_more_evidence"
          },
          {
            "name": "escalate-conflict-healthy-but-paged",
            "when": [
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "healthy"
              },
              {
                "path": "incident.evidence.signals.pager_alerts",
                "operator": "greater_or_equal",
                "value": 2
              }
            ],
            "result": "escalate_human"
          },
          {
            "name": "escalate-conflict-healthy-but-reported",
            "when": [
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "healthy"
              },
              {
                "path": "incident.evidence.signals.status_page_reports",
                "operator": "greater_or_equal",
                "value": 1
              }
            ],
            "result": "escalate_human"
          },
          {
            "name": "rollback-recent-high-risk-deploy-errors",
            "when": [
              {
                "path": "incident.evidence.deployments.0.risk",
                "operator": "equals",
                "value": "high"
              },
              {
                "path": "incident.evidence.deployments.0.minutes_ago",
                "operator": "less_or_equal",
                "value": 120
              },
              {
                "path": "incident.evidence.health.error_rate",
                "operator": "greater_or_equal",
                "value": 0.05
              }
            ],
            "result": "rollback"
          },
          {
            "name": "rollback-recent-high-risk-deploy-latency",
            "when": [
              {
                "path": "incident.evidence.deployments.0.risk",
                "operator": "equals",
                "value": "high"
              },
              {
                "path": "incident.evidence.deployments.0.minutes_ago",
                "operator": "less_or_equal",
                "value": 120
              },
              {
                "path": "incident.evidence.health.latency_p99_ms",
                "operator": "greater_or_equal",
                "value": 2000
              }
            ],
            "result": "rollback"
          },
          {
            "name": "flag-off-recent-medium-risk-deploy",
            "when": [
              {
                "path": "incident.evidence.deployments.0.risk",
                "operator": "equals",
                "value": "medium"
              },
              {
                "path": "incident.evidence.deployments.0.minutes_ago",
                "operator": "less_or_equal",
                "value": 120
              },
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "degraded"
              }
            ],
            "result": "disable_feature_flag"
          },
          {
            "name": "monitor-recent-low-risk-deploy",
            "when": [
              {
                "path": "incident.evidence.deployments.0.risk",
                "operator": "equals",
                "value": "low"
              },
              {
                "path": "incident.evidence.deployments.0.minutes_ago",
                "operator": "less_or_equal",
                "value": 120
              },
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "degraded"
              }
            ],
            "result": "monitor"
          },
          {
            "name": "scale-out-saturated",
            "when": [
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "degraded"
              },
              {
                "path": "incident.evidence.health.saturation",
                "operator": "greater_or_equal",
                "value": 0.85
              }
            ],
            "result": "scale_out"
          },
          {
            "name": "escalate-degraded-no-explanation",
            "when": [
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "degraded"
              }
            ],
            "result": "escalate_human"
          },
          {
            "name": "monitor-healthy",
            "when": [
              {
                "path": "incident.evidence.health.status",
                "operator": "equals",
                "value": "healthy"
              }
            ],
            "result": "monitor"
          }
        ],
        "default": "gather_more_evidence"
      },
      "fail_on_invalid": true,
      "inputs": {
        "value": {
          "type": "structured"
        },
        "text": {
          "type": "string"
        }
      },
      "outputs": {
        "text": {
          "type": "string"
        },
        "result": {
          "type": "structured"
        },
        "valid": {
          "type": "boolean"
        },
        "metadata": {
          "type": "structured"
        }
      }
    },
    "join": {
      "id": "join",
      "type": "join",
      "label": "Join the assessments",
      "mode": "all",
      "inputs": {
        "incident": {
          "type": "structured"
        },
        "severity": {
          "type": "structured"
        },
        "action": {
          "type": "structured"
        },
        "update": {
          "type": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "string"
        },
        "merged": {
          "type": "structured"
        }
      }
    },
    "summarize": {
      "id": "summarize",
      "type": "template",
      "label": "Verdict",
      "template": "{\n  \"verdict\": \"{{severity.decision}} {{action.decision}}\",\n  \"incident_id\": \"{{incident.incident_id}}\",\n  \"service\": \"{{incident.service}}\",\n  \"environment\": \"{{incident.environment}}\",\n  \"severity\": \"{{severity.decision}}\",\n  \"action\": \"{{action.decision}}\",\n  \"severity_rule\": \"{{severity.matched_rule}}\",\n  \"action_rule\": \"{{action.matched_rule}}\",\n  \"stakeholder_update\": \"{{update}}\"\n}",
      "output_format": "json",
      "missing_variable_mode": "empty",
      "inputs": {
        "input": {
          "type": "string"
        },
        "variables": {
          "type": "structured"
        }
      },
      "outputs": {
        "text": {
          "type": "string"
        },
        "result": {
          "type": "structured"
        },
        "metadata": {
          "type": "structured"
        }
      }
    },
    "triage_router": {
      "id": "triage_router",
      "type": "router",
      "label": "Route by action",
      "inputs": {
        "report": {
          "type": "string"
        },
        "facts": {
          "type": "structured"
        }
      },
      "outputs": {
        "route": {
          "type": "string"
        }
      },
      "branches": [
        {
          "condition": {
            "field": "facts.action",
            "op": "equals",
            "value": "rollback"
          },
          "to": "review"
        },
        {
          "condition": {
            "field": "facts.action",
            "op": "in",
            "value": [
              "escalate_human",
              "gather_more_evidence"
            ]
          },
          "to": "handoff_note"
        },
        {
          "to": "recommendation"
        }
      ]
    },
    "review": {
      "id": "review",
      "type": "human_approval",
      "label": "Approve the rollback",
      "required_role": "caliber.approver",
      "approval_count": 1,
      "inputs": {
        "response": {
          "type": "string"
        }
      },
      "outputs": {
        "approved": {
          "type": "string"
        }
      }
    },
    "rollback_request": {
      "id": "rollback_request",
      "type": "template",
      "label": "Rollback released after approval",
      "template": "ROLLBACK_APPROVED. A human approved the rollback; the on-call may execute it now.\nVerdict: {{input}}",
      "output_format": "text",
      "missing_variable_mode": "preserve",
      "inputs": {
        "input": {
          "type": "string"
        },
        "variables": {
          "type": "structured"
        }
      },
      "outputs": {
        "text": {
          "type": "string"
        },
        "result": {
          "type": "structured"
        },
        "metadata": {
          "type": "structured"
        }
      }
    },
    "handoff_note": {
      "id": "handoff_note",
      "type": "template",
      "label": "Hand off to the on-call",
      "template": "HANDOFF. Evidence is missing or conflicting; a human decides the next step.\nVerdict: {{input}}",
      "output_format": "text",
      "missing_variable_mode": "preserve",
      "inputs": {
        "input": {
          "type": "string"
        },
        "variables": {
          "type": "structured"
        }
      },
      "outputs": {
        "text": {
          "type": "string"
        },
        "result": {
          "type": "structured"
        },
        "metadata": {
          "type": "structured"
        }
      }
    },
    "recommendation": {
      "id": "recommendation",
      "type": "template",
      "label": "Recommend a low-risk action",
      "template": "RECOMMENDATION. No approval needed for this action.\nVerdict: {{input}}",
      "output_format": "text",
      "missing_variable_mode": "preserve",
      "inputs": {
        "input": {
          "type": "string"
        },
        "variables": {
          "type": "structured"
        }
      },
      "outputs": {
        "text": {
          "type": "string"
        },
        "result": {
          "type": "structured"
        },
        "metadata": {
          "type": "structured"
        }
      }
    },
    "final": {
      "id": "final",
      "type": "output",
      "inputs": {
        "response": {
          "type": "string"
        }
      }
    }
  },
  "edges": [
    {
      "id": "e_start_fan",
      "from": "start",
      "to": "fan_out",
      "map": {
        "incident": "input"
      }
    },
    {
      "id": "e_fan_ingest",
      "from": "fan_out",
      "to": "ingest",
      "map": {
        "output": "text"
      }
    },
    {
      "id": "e_fan_sev",
      "from": "fan_out",
      "to": "severity_table",
      "map": {
        "output": "text"
      }
    },
    {
      "id": "e_fan_act",
      "from": "fan_out",
      "to": "action_table",
      "map": {
        "output": "text"
      }
    },
    {
      "id": "e_fan_update",
      "from": "fan_out",
      "to": "draft_update",
      "map": {
        "output": "input"
      }
    },
    {
      "id": "e_update_join",
      "from": "draft_update",
      "to": "join",
      "map": {
        "final_output": "update"
      }
    },
    {
      "id": "e_ingest_join",
      "from": "ingest",
      "to": "join",
      "map": {
        "result": "incident"
      }
    },
    {
      "id": "e_sev_join",
      "from": "severity_table",
      "to": "join",
      "map": {
        "result": "severity"
      }
    },
    {
      "id": "e_act_join",
      "from": "action_table",
      "to": "join",
      "map": {
        "result": "action"
      }
    },
    {
      "id": "e_join_summary",
      "from": "join",
      "to": "summarize",
      "map": {
        "merged": "variables"
      }
    },
    {
      "id": "e_summary_router",
      "from": "summarize",
      "to": "triage_router",
      "map": {
        "text": "report",
        "result": "facts"
      }
    },
    {
      "id": "e_router_review",
      "from": "triage_router",
      "to": "review",
      "map": {
        "route": "response"
      }
    },
    {
      "id": "e_router_handoff",
      "from": "triage_router",
      "to": "handoff_note",
      "map": {
        "route": "input"
      }
    },
    {
      "id": "e_router_reco",
      "from": "triage_router",
      "to": "recommendation",
      "map": {
        "route": "input"
      }
    },
    {
      "id": "e_review_rollback",
      "from": "review",
      "to": "rollback_request",
      "map": {
        "approved": "input"
      }
    },
    {
      "id": "e_rollback_final",
      "from": "rollback_request",
      "to": "final",
      "map": {
        "text": "response"
      }
    },
    {
      "id": "e_handoff_final",
      "from": "handoff_note",
      "to": "final",
      "map": {
        "text": "response"
      }
    },
    {
      "id": "e_reco_final",
      "from": "recommendation",
      "to": "final",
      "map": {
        "text": "response"
      }
    }
  ],
  "tools": {},
  "artifacts": {
    "eval_datasets": {
      "incident-cases": {
        "dataset_name": "incident-cases"
      }
    }
  },
  "deploy_gates": {
    "verdict-matches-dataset": {
      "type": "deploy_gate",
      "dataset_ref": "incident-cases",
      "required_for_aliases": [
        "prod"
      ],
      "scorers": [
        "contains_expected"
      ],
      "pass_threshold": 1.0,
      "thresholds": {
        "min_pass_rate": 1.0,
        "min_contains_expected": 1.0,
        "max_error_rate": 0.0
      }
    }
  }
}