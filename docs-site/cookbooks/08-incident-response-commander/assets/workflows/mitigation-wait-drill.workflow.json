{
  "schema_version": 1,
  "workflow_id": "WF-IMPORTED",
  "name": "mitigation-wait-drill",
  "description": "Cookbook 08 drill: pause until the on-call confirms the mitigation, then continue.",
  "runtime": {
    "sdk": "openai-agents-python",
    "sdk_version_policy": "runtime-pinned",
    "compiler_version": "caliber-workflow-compiler-v1",
    "default_model_ref": "CALIBER_WORKFLOW_DEFAULT_MODEL",
    "session": {
      "type": "none"
    }
  },
  "nodes": {
    "start": {
      "id": "start",
      "type": "start",
      "label": "Input",
      "outputs": {
        "msg": {
          "type": "string"
        }
      }
    },
    "wait": {
      "id": "wait",
      "type": "wait_for_event",
      "label": "Wait for the mitigation to be confirmed",
      "event_name": "incident.mitigation_confirmed",
      "correlation_key": "incident_id",
      "timeout_seconds": 3600,
      "inputs": {
        "input": {
          "type": "string"
        }
      },
      "outputs": {
        "output": {
          "type": "string"
        },
        "event_payload": {
          "type": "structured"
        },
        "event_name": {
          "type": "string"
        }
      }
    },
    "final": {
      "id": "final",
      "type": "output",
      "inputs": {
        "response": {
          "type": "string"
        }
      }
    }
  },
  "edges": [
    {
      "id": "e_start_wait",
      "from": "start",
      "to": "wait",
      "map": {
        "msg": "input"
      }
    },
    {
      "id": "e_wait_final",
      "from": "wait",
      "to": "final",
      "map": {
        "output": "response"
      }
    }
  ],
  "tools": {}
}