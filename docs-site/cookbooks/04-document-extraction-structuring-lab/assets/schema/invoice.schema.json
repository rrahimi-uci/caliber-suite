{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracted invoice",
  "type": "object",
  "required": [
    "document_type",
    "invoice_number",
    "vendor",
    "invoice_date",
    "currency",
    "line_items",
    "total"
  ],
  "properties": {
    "document_type": {
      "const": "invoice"
    },
    "invoice_number": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$"
    },
    "vendor": {
      "type": "string",
      "minLength": 2
    },
    "invoice_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currency": {
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "JPY",
        "CAD"
      ]
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "description",
          "quantity",
          "unit_price",
          "amount"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "total_reconciles": {
      "enum": [
        true,
        null
      ]
    },
    "encoding_clean": {
      "const": true
    },
    "truncated": {
      "const": false
    }
  }
}
