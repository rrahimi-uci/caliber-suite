# Copy to .env — do not commit real secrets.
# All values shown are defaults; uncomment to override.
#
# ./start.sh, ./stop.sh, and the Makefile load deploy/.env first (infra ports /
# bucket names) and this suite-root .env second (app settings / secrets), so
# values here win when both files define the same key.
#
# IMPORTANT: Each service script cd's into its own directory before reading
# these vars. Relative paths resolve from the SERVICE dir, not the repo root.
# Use absolute paths if overriding file locations.

# ── LLM API Keys ────────────────────────────────────────────
# These are the actual secret keys. Never commit real values.
# Container real mode uses CALIBER_LLM_PROVIDER=openai and reads this by default.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── MLflow (paths relative to mlflow/) ──────────────────────
# MLFLOW_HOST=127.0.0.1
# MLFLOW_PORT=5000
# MLFLOW_BACKEND_URI=sqlite:///mlflow.db
# MLFLOW_ARTIFACT_ROOT=./artifacts
#
# To store MLflow artifacts in MinIO/S3 instead of local disk:
# MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
# MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ── CALIBER Core (paths relative to caliber/) ──────────────
# CALIBER_HOST=127.0.0.1
# CALIBER_PORT=5001
# CALIBER_DATABASE_URL=sqlite:///caliber.db
# CALIBER_LOG_LEVEL=INFO
# CALIBER_LOG_SINK=s3
# CALIBER_LOG_BUCKET=caliber-log
# CALIBER_LOG_PREFIX=service
# CALIBER_LOG_S3_AUTO_CREATE_BUCKET=true
# CALIBER_LOG_S3_FLUSH_LINES=1
# CALIBER_DEV_USER=@local-admin
# CALIBER_ADMIN_USERS=@local-admin
# CALIBER_APPROVER_USERS=@local-admin
# CALIBER_OPERATOR_USERS=@local-admin
# CALIBER_BUILTIN_SKILLS_AUTO_SEED=true
# CALIBER_SKIP_UI_BUILD=0
# CALIBER_SEED_DEMO=workflow-studio
# CALIBER_KNOWLEDGE_GRAPH_EXTRACTOR_BACKEND=spacy
# CALIBER_KNOWLEDGE_GRAPH_SPACY_MODEL=en_core_web_sm
# CALIBER_KNOWLEDGE_AGE_ENABLED=true
# CALIBER_KNOWLEDGE_AGE_GRAPH_NAME=knowledge_graph

# ── LLM Provider ────────────────────────────────────────────
# Switch from "fake" to "openai" to use real LLM calls.
# CALIBER_LLM_PROVIDER=fake
# CALIBER_LLM_API_KEY_ENV=OPENAI_API_KEY
# CALIBER_LLM_DIAGNOSIS_MODEL=gpt-4o-mini

# ── Assistant ────────────────────────────────────────────────
# Engine: "auto" (default — picks a real provider by available API key:
# OpenAI if OPENAI_API_KEY is set, else Anthropic/Claude if ANTHROPIC_API_KEY
# is set), or force "openai" / "anthropic" / "ollama". "fake" is a test-only
# stub and is never selected automatically.
# CALIBER_ASSISTANT_ENGINE=auto
# Empty model = the resolved provider's default (OpenAI gpt-5.2 / Claude sonnet-4).
# CALIBER_ASSISTANT_MODEL=

# ── Provider Backends ───────────────────────────────────────
# Switch from "fake" to "mlflow" when MLflow is running.
# CALIBER_ARTIFACT_STORE_PROVIDER=fake
# CALIBER_EVAL_PROVIDER=fake
# CALIBER_PROMOTER_PROVIDER=fake

# ── Event Bus (NATS or Redis) ───────────────────────────────
# Container app deployments default to NATS for cross-instance live event
# fanout. Set CALIBER_WORKFLOW_RUN_EVENT_BACKEND=redis to switch the shared bus
# to Redis pub/sub instead.
# CALIBER_WORKFLOW_RUN_EVENT_BACKEND=nats
# CALIBER_NATS_URL=nats://127.0.0.1:4222
# CALIBER_NATS_SUBJECT=caliber.events
# CALIBER_REDIS_URL=redis://127.0.0.1:6379/0
# CALIBER_REDIS_CHANNEL=caliber.events

# ── Workflow Storage (MinIO / S3) ───────────────────────────
# Switch from "local" to "s3" for MinIO or AWS S3.
# CALIBER_WORKFLOW_STORAGE_BACKEND=local
# CALIBER_WORKFLOW_STORAGE_BASE_URI=file://./caliber-workspaces
#
# S3/MinIO settings (required when backend=s3):
# CALIBER_WORKFLOW_STORAGE_BUCKET=caliber-workspaces
# CALIBER_WORKFLOW_STORAGE_PREFIX=
# CALIBER_WORKFLOW_STORAGE_INTERNAL_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_REGION=us-east-1
# CALIBER_WORKFLOW_STORAGE_FORCE_PATH_STYLE=true
# CALIBER_WORKFLOW_STORAGE_ACCESS_KEY_SOURCE=MINIO_ACCESS_KEY
# CALIBER_WORKFLOW_STORAGE_SECRET_KEY_SOURCE=MINIO_SECRET_KEY
#
# The actual MinIO credentials (referenced by *_SOURCE above):
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
#
# Upload limits / quotas:
# CALIBER_WORKFLOW_STORAGE_MAX_UPLOAD_BYTES=262144000
# CALIBER_WORKFLOW_STORAGE_MAX_RUN_BYTES=2147483648
# CALIBER_WORKFLOW_STORAGE_SIGNED_URL_TTL_SECONDS=900

# ── MLflow AI Gateway (LLM gateway) ─────────────────────────
# CALIBER_GATEWAY_URI=http://mlflow-gateway:5002   # discovery URI (Settings → Services / Gateway)
# CALIBER_LLM_BASE_URL=http://mlflow-gateway:5002/gateway   # opt-in: route LLM calls through the gateway
# MLFLOW_GATEWAY_PORT=5002

# ═══════════════════════════════════════════════════════════════
# EXAMPLE: Local MinIO setup (docker)
# ═══════════════════════════════════════════════════════════════
#
# 1. Start MinIO with Docker:
#
#    docker run -d --name minio \
#      -p 9000:9000 -p 9001:9001 \
#      -e MINIO_ROOT_USER=minioadmin \
#      -e MINIO_ROOT_PASSWORD=minioadmin \
#      -v minio-data:/data \
#      minio/minio server /data --console-address ":9001"
#
# 2. Create buckets (one-time):
#
#    docker exec minio mc alias set local http://localhost:9000 minioadmin minioadmin
#    docker exec minio mc mb local/mlflow-artifacts
#    docker exec minio mc mb local/caliber-workspaces
#    docker exec minio mc mb local/caliber-log
#
# 3. Uncomment the block below in your .env:
#
# --- MinIO credentials (shared by MLflow and CALIBER) ---
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
#
# --- MLflow artifact store -> MinIO ---
# MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
# MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
#
# --- CALIBER workflow storage -> MinIO ---
# CALIBER_WORKFLOW_STORAGE_BACKEND=s3
# CALIBER_WORKFLOW_STORAGE_BUCKET=caliber-workspaces
# CALIBER_WORKFLOW_STORAGE_INTERNAL_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_REGION=us-east-1
# CALIBER_WORKFLOW_STORAGE_FORCE_PATH_STYLE=true
# CALIBER_WORKFLOW_STORAGE_ACCESS_KEY_SOURCE=MINIO_ACCESS_KEY
# CALIBER_WORKFLOW_STORAGE_SECRET_KEY_SOURCE=MINIO_SECRET_KEY
#
# --- CALIBER Object Store connection (also used by S3 logs) ---
# CALIBER_OBJECT_STORE_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_OBJECT_STORE_REGION=us-east-1
# CALIBER_OBJECT_STORE_FORCE_PATH_STYLE=true
# CALIBER_OBJECT_STORE_ACCESS_KEY_SOURCE=MINIO_ACCESS_KEY
# CALIBER_OBJECT_STORE_SECRET_KEY_SOURCE=MINIO_SECRET_KEY
#
# --- CALIBER service logs -> MinIO ---
# CALIBER_LOG_SINK=s3
# CALIBER_LOG_BUCKET=caliber-log
# CALIBER_LOG_PREFIX=service
# CALIBER_LOG_S3_AUTO_CREATE_BUCKET=true
#
# 4. MinIO Console UI: http://127.0.0.1:9001
#    Login with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
#
# 5. Install boto3 if not already in your venv:
#    pip install boto3
