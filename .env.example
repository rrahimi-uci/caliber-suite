# Copy to .env — do not commit real secrets.
# All values shown are defaults; uncomment to override.
#
# ./start.sh, ./stop.sh, and the Makefile load deploy/.env first (infra ports /
# bucket names) and this suite-root .env second (app settings / secrets), so
# values here win when both files define the same key.
#
# IMPORTANT: Each service script cd's into its own directory before reading
# these vars. Relative paths resolve from the SERVICE dir, not the repo root.
# Use absolute paths if overriding file locations.

# ── LLM API Keys ────────────────────────────────────────────
# These are the actual secret keys. Never commit real values.
# Container real mode uses CALIBER_LLM_PROVIDER=openai and reads this by default.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── MLflow (paths relative to mlflow/) ──────────────────────
# MLFLOW_HOST=127.0.0.1
# MLFLOW_PORT=5000
# MLFLOW_BACKEND_URI=sqlite:///mlflow.db
# MLFLOW_ARTIFACT_ROOT=./artifacts
#
# To store MLflow artifacts in MinIO/S3 instead of local disk:
# MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
# MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ── CALIBER Core (paths relative to caliber/) ──────────────
# CALIBER_HOST=127.0.0.1
# CALIBER_PORT=5001
# CALIBER_DATABASE_URL=sqlite:///caliber.db
# CALIBER_LOG_LEVEL=INFO
# CALIBER_LOG_SINK=s3
# CALIBER_LOG_BUCKET=caliber-log
# CALIBER_LOG_PREFIX=service
# CALIBER_LOG_S3_AUTO_CREATE_BUCKET=true
# CALIBER_LOG_S3_FLUSH_LINES=1
# CALIBER_DEV_USER=@local-admin
# CALIBER_ADMIN_USERS=@local-admin
# CALIBER_APPROVER_USERS=@local-admin
# CALIBER_OPERATOR_USERS=@local-admin
# CALIBER_BUILTIN_SKILLS_AUTO_SEED=true
# CALIBER_SKIP_UI_BUILD=0
# CALIBER_SEED_DEMO=workflow-studio
# CALIBER_KNOWLEDGE_GRAPH_EXTRACTOR_BACKEND=spacy
# CALIBER_KNOWLEDGE_GRAPH_SPACY_MODEL=en_core_web_sm
# CALIBER_KNOWLEDGE_AGE_ENABLED=true
# CALIBER_KNOWLEDGE_AGE_GRAPH_NAME=knowledge_graph

# ── LLM Provider ────────────────────────────────────────────
# Switch from "fake" to "openai" to use real LLM calls.
# CALIBER_LLM_PROVIDER=fake
# CALIBER_LLM_API_KEY_ENV=OPENAI_API_KEY
# CALIBER_LLM_DIAGNOSIS_MODEL=gpt-4o-mini

# ── Assistant ────────────────────────────────────────────────
# Engine: "auto" (default — picks a real provider by available API key:
# OpenAI if OPENAI_API_KEY is set, else Anthropic/Claude if ANTHROPIC_API_KEY
# is set), or force "openai" / "anthropic" / "ollama". "fake" is a test-only
# stub and is never selected automatically.
# CALIBER_ASSISTANT_ENGINE=auto
# Empty model = the resolved provider's default (OpenAI gpt-5.2 / Claude sonnet-4).
# CALIBER_ASSISTANT_MODEL=

# ── Provider Backends ───────────────────────────────────────
# Switch from "fake" to "mlflow" when MLflow is running.
# CALIBER_ARTIFACT_STORE_PROVIDER=fake
# CALIBER_EVAL_PROVIDER=fake
# CALIBER_PROMOTER_PROVIDER=fake

# ── Tool and MCP containment ───────────────────────────────
# Local tool code runs in a short-lived, environment-empty Python process with
# wall/CPU/memory/file/open-file limits. This is process containment, not a
# substitute for a container/VM/kernel sandbox when authors are untrusted.
# Keep registered tools sandboxed unless a trusted compatibility test explicitly
# requires in-process imports. A production deployment can provide a hardened
# ToolSandbox factory as package.module:Factory.
# CALIBER_REGISTERED_TOOL_SANDBOX_ENABLED=true
# CALIBER_REGISTERED_TOOL_SANDBOX_TIMEOUT_SECONDS=30
# CALIBER_TOOL_SANDBOX_BACKEND=mycompany.sandbox:Factory
# CALIBER_TOOL_SANDBOX_TIMEOUT_SECONDS=5
# CALIBER_TOOL_SANDBOX_MAX_OUTPUT_BYTES=1048576
# CALIBER_TOOL_SANDBOX_MAX_MEMORY_BYTES=268435456
# CALIBER_TOOL_SANDBOX_MAX_FILE_BYTES=1048576
# CALIBER_TOOL_SANDBOX_MAX_OPEN_FILES=32
#
# MCP stdio commands and remote hosts are fail-closed allowlists. The safe
# default permits only CALIBER's bundled Python MCP module and loopback hosts.
# Add npx/docker/etc. deliberately; they are arbitrary local executables and do
# not become sandboxed merely because they are allowlisted.
# CALIBER_MCP_STDIO_COMMAND_ALLOWLIST=${PYTHON}
# CALIBER_MCP_STDIO_SAFE_PATH=/usr/local/bin:/usr/bin:/bin
# CALIBER_MCP_STDIO_PYTHON_MODULE_ALLOWLIST=caliber.mcp_servers.db
# CALIBER_MCP_STDIO_PYTHON_SCRIPT_ALLOWLIST=
# CALIBER_MCP_REMOTE_HOST_ALLOWLIST=localhost,127.0.0.1,::1
# Operator-attested, separately isolated container/VM hosts (empty outside the
# shipped compose stack). Never add an ordinary remote endpoint merely to make
# a production preflight pass.
# CALIBER_MCP_MANAGED_SIDECAR_HOSTS=
# Development default only: this points the DB MCP sidecars at CALIBER's own
# metadata database with a privileged role. Production must use a separate
# database/schema and least-privilege role; container isolation does not limit
# SQL authority.
# CALIBER_MCP_POSTGRES_URL=postgresql://caliber:caliber@postgres:5432/caliber
# CALIBER_MCP_ALLOW_INSECURE_HTTP=false
# CALIBER_MCP_STDIO_ISOLATED_WORKDIR=true
#
# Production aliases reject all local stdio MCP, including wrappers. Use a
# managed sidecar or non-loopback HTTPS endpoint for a production boundary.
# Bubblewrap can still harden development/CI containment but does not satisfy
# production preflight because this profile exposes host files read-only.
# CALIBER_MCP_STDIO_ISOLATION_PROFILE=none
# CALIBER_MCP_STDIO_ISOLATION_PREFIX=
# Exact recognized containment profile on a Linux host with bwrap installed. The target
# command is appended by CALIBER; extra flags/commands make the profile fail
# closed. The host root remains readable but is not writable, and network is
# unshared. Prefer a sidecar/VM when host-file confidentiality is required.
# CALIBER_MCP_STDIO_ISOLATION_PROFILE=bubblewrap
# CALIBER_MCP_STDIO_ISOLATION_PREFIX=bwrap --unshare-all --die-with-parent --new-session --ro-bind / / --proc /proc --dev /dev --tmpfs /tmp --chdir /tmp

# ── Identity boundary (C1) ──────────────────────────────────
# 'session' (default) — CALIBER validates a password against caliber_user_accounts
# and issues a revocable session. X-CALIBER-User is IGNORED in this mode, which is
# what makes the authorization checks elsewhere enforce a real boundary.
# 'trusted_header' — restores header trust for a deployment genuinely behind an
# identity proxy. Combine it with the proxy secret below so a request that bypasses
# the proxy cannot assert an identity.
# CALIBER_AUTH_MODE=session
# CALIBER_AUTH_TRUSTED_PROXY_SECRET_ENV=
# The no-header dev fallback. OFF by default: with the admin lists above set to
# @local-admin, this previously made an UNAUTHENTICATED request an admin. Only
# honoured in trusted_header mode. Never enable on a reachable deployment.
# CALIBER_AUTH_DEV_FALLBACK_ENABLED=false
# CALIBER_AUTH_SESSION_TTL_SECONDS=43200
# CALIBER_AUTH_SESSION_COOKIE_NAME=caliber_session
# Secure cookie by default; set false only for plain-HTTP local development, where
# the browser would otherwise drop it.
# CALIBER_AUTH_SESSION_COOKIE_SECURE=true
# Seeded ONLY when no account exists yet, so a fresh session-mode deployment is
# reachable. The password comes from the named source (never inline) and must pass
# the same strength rules as any other, so a well-known default cannot be seeded.
# CALIBER_AUTH_BOOTSTRAP_ADMIN_USER=@owner
# CALIBER_AUTH_BOOTSTRAP_ADMIN_PASSWORD_ENV=CALIBER_BOOTSTRAP_PASSWORD

# ── Encrypted secret store (C2) ─────────────────────────────
# Enables 'secret://name' references, resolved from AES-256-GCM ciphertext with
# rotation and revocation. Without a key the store is disabled and a secret://
# reference resolves to NOTHING — callers fail closed rather than reading a
# plaintext fallback. Generate a key with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# CALIBER_SECRET_ENCRYPTION_KEY_SOURCE=CALIBER_SECRET_KEY
# Retain the previous key here after rotating, so versions it wrote still decrypt.
# CALIBER_SECRET_ENCRYPTION_ADDITIONAL_KEYS=

# ── Outbound egress policy (SSRF defence) ───────────────────
# Checked against the RESOLVED address of a webhook/api_request URL, because a
# hostname allowlist alone does not stop a name that resolves to 169.254.169.254.
# CALIBER_EGRESS_POLICY_ENABLED=true
# CALIBER_EGRESS_BLOCKED_CATEGORIES=link_local,loopback,private,other_reserved
# Hosts always permitted, even inside a blocked range — how an internal service
# stays reachable without reopening the cloud metadata endpoint.
# CALIBER_EGRESS_ALLOWED_HOSTS=

# ── external_app entrypoints (C8) ───────────────────────────
# An external_app node imports and invokes installed Python IN the CALIBER process.
# Empty means NONE are permitted; every other execution surface already shipped an
# allowlist. A trailing '*' allows a module prefix.
# CALIBER_EXTERNAL_APP_ENTRYPOINT_ALLOWLIST=mycompany.integrations.*

# ── Registered tool modules (C8) ────────────────────────────
# A registered tool's module_path is imported and invoked in the configured sandbox
# child by default. Disabling the sandbox restores in-process execution but does not
# disable this allowlist. Empty means unrestricted, which is the shipped default
# because registering a tool already requires the admin scope and a fail-closed default
# would break existing installs on upgrade — but /readiness reports the unset state.
# CALIBER_REGISTERED_TOOL_MODULE_ALLOWLIST=caliber.*,mycompany.tools.*

# ── Human-approval gates (C6) ───────────────────────────────
# required_role and approval_count on a human_approval node are ENFORCED, and the
# account that triggered a run cannot approve it. Enable self-approval only for a
# single-operator install, which would otherwise deadlock on its own gates.
# CALIBER_APPROVAL_ALLOW_SELF_APPROVAL=false

# Environment classes whose deploy gate must be graded by a REAL configured model.
# A production verdict produced by the deterministic fake executor proves the graph
# and the dataset, not the model that will serve traffic, so presenting it as release
# evidence is false confidence. Set to '' only for an install that deliberately runs
# CALIBER_LLM_PROVIDER=fake.
# CALIBER_RELEASE_REQUIRE_GRADED_EXECUTOR_FOR_ENVIRONMENT_CLASSES=production

# ── Deployment environment classes and release policy ──────
# Keyed to the alias's ENVIRONMENT CLASS, not its name: 'production', 'prod-eu',
# and 'PROD' all resolve to the production class, so no spelling escapes the
# requirement. An alias matching no pattern falls back to the production class,
# which is why the default below is safe. The legacy alias list still works as an
# additional opt-in.
# CALIBER_MCP_REQUIRE_EXTERNAL_ISOLATION_FOR_ENVIRONMENT_CLASSES=production
# CALIBER_MCP_REQUIRE_EXTERNAL_ISOLATION_FOR_ALIASES=prod
# Classify a house-style alias explicitly (wins over the name patterns), and pick
# the class for an alias that matches nothing. Leave the default at 'production'
# unless this is a development-only install.
# CALIBER_DEPLOYMENT_ENVIRONMENT_CLASSES=blue=production,green=production,demo=development
# CALIBER_DEPLOYMENT_DEFAULT_ENVIRONMENT_CLASS=production
#
# Release policy. A production-class promotion requires a PASSING deploy gate by
# default: rotating a live alias onto a version nothing graded is how false release
# evidence happens. Set to '' only for a development install or a migration.
# CALIBER_RELEASE_REQUIRE_QUALITY_GATE_FOR_ENVIRONMENT_CLASSES=production
# Pause a production promotion for human sign-off instead of rotating immediately.
# Empty ships single-environment behaviour; the approval machinery is fully wired.
# CALIBER_RELEASE_REQUIRE_HUMAN_APPROVAL_FOR_ENVIRONMENT_CLASSES=
#
# Service-level objectives evaluated by /caliber/system/alerts. An objective naming
# an unknown signal is reported as a configuration error, not silently ignored.
# Signals: workflow_success_rate, workflow_p95_latency_ms, workflow_avg_latency_ms,
# queue_oldest_wait_seconds, queue_stale_leases, webhook_dead_letters,
# readiness_blockers.
# CALIBER_SLO_OBJECTIVES=workflow_success_rate>=0.99,workflow_p95_latency_ms<=30000
# CALIBER_SLO_WINDOW_MINUTES=60
#
# Backlog tolerance for the workflow run queue: a run waiting longer than this marks
# the queue degraded, which is what separates 'busy' from 'nothing is consuming it'.
# CALIBER_WORKFLOW_QUEUE_MAX_AGE_SECONDS=300
#
# Ceiling on concurrent parallel-branch threads. The pool used to be sized to the
# branch count with no cap, so a wide graph spawned one thread per branch. Excess
# branches queue, so this changes throughput, not results.
# CALIBER_WORKFLOW_PARALLEL_BRANCH_MAX_WORKERS=8

# ── Event Bus (NATS or Redis) ───────────────────────────────
# Container app deployments default to NATS for cross-instance live event
# fanout. Set CALIBER_WORKFLOW_RUN_EVENT_BACKEND=redis to switch the shared bus
# to Redis pub/sub instead.
# CALIBER_WORKFLOW_RUN_EVENT_BACKEND=nats
# CALIBER_NATS_URL=nats://127.0.0.1:4222
# CALIBER_NATS_SUBJECT=caliber.events
# CALIBER_REDIS_URL=redis://127.0.0.1:6379/0
# CALIBER_REDIS_CHANNEL=caliber.events

# ── Workflow Storage (MinIO / S3) ───────────────────────────
# Switch from "local" to "s3" for MinIO or AWS S3.
# CALIBER_WORKFLOW_STORAGE_BACKEND=local
# CALIBER_WORKFLOW_STORAGE_BASE_URI=file://./caliber-workspaces
#
# S3/MinIO settings (required when backend=s3):
# CALIBER_WORKFLOW_STORAGE_BUCKET=caliber-workspaces
# CALIBER_WORKFLOW_STORAGE_PREFIX=
# CALIBER_WORKFLOW_STORAGE_INTERNAL_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_REGION=us-east-1
# CALIBER_WORKFLOW_STORAGE_FORCE_PATH_STYLE=true
# CALIBER_WORKFLOW_STORAGE_ACCESS_KEY_SOURCE=MINIO_ACCESS_KEY
# CALIBER_WORKFLOW_STORAGE_SECRET_KEY_SOURCE=MINIO_SECRET_KEY
#
# The actual MinIO credentials (referenced by *_SOURCE above):
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
#
# Upload limits / quotas:
# CALIBER_WORKFLOW_STORAGE_MAX_UPLOAD_BYTES=262144000
# CALIBER_WORKFLOW_STORAGE_MAX_RUN_BYTES=2147483648
# CALIBER_WORKFLOW_STORAGE_SIGNED_URL_TTL_SECONDS=900

# ── MLflow AI Gateway (LLM gateway) ─────────────────────────
# CALIBER_GATEWAY_URI=http://mlflow-gateway:5002   # discovery URI (Settings → Services / Gateway)
# CALIBER_LLM_BASE_URL=http://mlflow-gateway:5002/gateway   # opt-in: route LLM calls through the gateway
# MLFLOW_GATEWAY_PORT=5002

# ═══════════════════════════════════════════════════════════════
# EXAMPLE: Local MinIO setup (docker)
# ═══════════════════════════════════════════════════════════════
#
# 1. Start MinIO with Docker:
#
#    docker run -d --name minio \
#      -p 9000:9000 -p 9001:9001 \
#      -e MINIO_ROOT_USER=minioadmin \
#      -e MINIO_ROOT_PASSWORD=minioadmin \
#      -v minio-data:/data \
#      minio/minio server /data --console-address ":9001"
#
# 2. Create buckets (one-time):
#
#    docker exec minio mc alias set local http://localhost:9000 minioadmin minioadmin
#    docker exec minio mc mb local/mlflow-artifacts
#    docker exec minio mc mb local/caliber-workspaces
#    docker exec minio mc mb local/caliber-log
#
# 3. Uncomment the block below in your .env:
#
# --- MinIO credentials (shared by MLflow and CALIBER) ---
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
#
# --- MLflow artifact store -> MinIO ---
# MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts
# MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
#
# --- CALIBER workflow storage -> MinIO ---
# CALIBER_WORKFLOW_STORAGE_BACKEND=s3
# CALIBER_WORKFLOW_STORAGE_BUCKET=caliber-workspaces
# CALIBER_WORKFLOW_STORAGE_INTERNAL_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_WORKFLOW_STORAGE_REGION=us-east-1
# CALIBER_WORKFLOW_STORAGE_FORCE_PATH_STYLE=true
# CALIBER_WORKFLOW_STORAGE_ACCESS_KEY_SOURCE=MINIO_ACCESS_KEY
# CALIBER_WORKFLOW_STORAGE_SECRET_KEY_SOURCE=MINIO_SECRET_KEY
#
# --- CALIBER Object Store connection (also used by S3 logs) ---
# CALIBER_OBJECT_STORE_ENDPOINT_URL=http://127.0.0.1:9000
# CALIBER_OBJECT_STORE_REGION=us-east-1
# CALIBER_OBJECT_STORE_FORCE_PATH_STYLE=true
# CALIBER_OBJECT_STORE_ACCESS_KEY_SOURCE=MINIO_ACCESS_KEY
# CALIBER_OBJECT_STORE_SECRET_KEY_SOURCE=MINIO_SECRET_KEY
#
# --- CALIBER service logs -> MinIO ---
# CALIBER_LOG_SINK=s3
# CALIBER_LOG_BUCKET=caliber-log
# CALIBER_LOG_PREFIX=service
# CALIBER_LOG_S3_AUTO_CREATE_BUCKET=true
#
# 4. MinIO Console UI: http://127.0.0.1:9001
#    Login with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
#
# 5. Install boto3 if not already in your venv:
#    pip install boto3
