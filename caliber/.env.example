# Copy to .env for local overrides. Do not commit real secrets.
CALIBER_DATABASE_URL=sqlite:///./caliber.db
CALIBER_LLM_PROVIDER=fake
CALIBER_LLM_API_KEY_ENV=OPENAI_API_KEY
CALIBER_LOG_LEVEL=INFO

# Default: mirror JSON service logs into the Object Store / S3 bucket.
# Uses CALIBER_OBJECT_STORE_* connection settings (defaults target local MinIO).
# Install the s3 extra for bucket delivery: pip install -e ".[s3]" or pip install "caliber[s3]"
# Set CALIBER_LOG_SINK=stderr to disable bucket mirroring.
# CALIBER_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
# CALIBER_OBJECT_STORE_REGION=us-east-1
# CALIBER_OBJECT_STORE_FORCE_PATH_STYLE=true
# CALIBER_OBJECT_STORE_ACCESS_KEY_SOURCE=MINIO_ROOT_USER
# CALIBER_OBJECT_STORE_SECRET_KEY_SOURCE=MINIO_ROOT_PASSWORD
CALIBER_LOG_SINK=s3
CALIBER_LOG_BUCKET=caliber-log
CALIBER_LOG_PREFIX=service
CALIBER_LOG_S3_AUTO_CREATE_BUCKET=true
CALIBER_LOG_S3_FLUSH_LINES=1
CALIBER_KNOWLEDGE_GRAPH_EXTRACTOR_BACKEND=spacy
CALIBER_KNOWLEDGE_GRAPH_SPACY_MODEL=en_core_web_sm

# Optional for local standalone development.
CALIBER_DEV_USER=@local-admin
CALIBER_ADMIN_USERS=@local-admin
CALIBER_APPROVER_USERS=@local-admin
CALIBER_OPERATOR_USERS=@local-admin

# File Directory storage.
# BACKEND is the default for workflow/run files and new directories when the
# user does not choose one. The UI can offer both local and MinIO/S3 when the
# MinIO/S3 fields below are set.
CALIBER_WORKFLOW_STORAGE_BACKEND=local
CALIBER_WORKFLOW_STORAGE_BASE_URI=file://./caliber-workspaces

# Uncomment to enable the MinIO / S3-compatible option in File Directory.
# Install the s3 extra first: pip install -e ".[s3]" or pip install "caliber[s3]"
# CALIBER_WORKFLOW_STORAGE_BUCKET=caliber-workspaces
# CALIBER_WORKFLOW_STORAGE_PREFIX=
# CALIBER_WORKFLOW_STORAGE_INTERNAL_ENDPOINT_URL=http://localhost:9000
# CALIBER_WORKFLOW_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
# CALIBER_WORKFLOW_STORAGE_REGION=us-east-1
# CALIBER_WORKFLOW_STORAGE_FORCE_PATH_STYLE=true
# CALIBER_WORKFLOW_STORAGE_ACCESS_KEY_SOURCE=MINIO_ROOT_USER
# CALIBER_WORKFLOW_STORAGE_SECRET_KEY_SOURCE=MINIO_ROOT_PASSWORD
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
