{
  "library_version": "1.0.0",
  "source": "https://www.promptingguide.ai/",
  "element_model": ["instruction", "context", "input", "output_indicator"],
  "render_order": "instruction -> context? -> examples? -> input -> output_indicator",
  "templates": [
    {
      "id": "zs-instruct",
      "version": "1.0.0",
      "technique": "zero-shot",
      "domain": "question-answering",
      "instruction": "{instruction}",
      "context": null,
      "examples": [],
      "input": "Input:\n{input}",
      "output_indicator": "Answer concisely.",
      "variables": [
        { "name": "instruction", "required": true, "description": "the task to perform" },
        { "name": "input", "required": true, "description": "the data to act on" }
      ],
      "output_format": "prose",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["add-fewshot", "add-cot", "format-enforce"],
      "source": "https://www.promptingguide.ai/techniques/zeroshot",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "fs-demos",
      "version": "1.0.0",
      "technique": "few-shot",
      "domain": "classification",
      "instruction": "{instruction}",
      "context": null,
      "examples": "{examples}",
      "input": "Input: {input}\nOutput:",
      "output_indicator": "Match the format shown in the examples exactly.",
      "variables": [
        { "name": "instruction", "required": true, "description": "task description" },
        { "name": "examples", "required": true, "description": "list of input/output demonstration pairs" },
        { "name": "input", "required": true, "description": "the new item to label" }
      ],
      "output_format": "enum",
      "sampling_policy": "eval=100%",
      "composable_with": ["format-enforce", "self-critique"],
      "source": "https://www.promptingguide.ai/techniques/fewshot",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "cot-stepwise",
      "version": "1.0.0",
      "technique": "cot",
      "domain": "reasoning",
      "instruction": "Solve the problem below.",
      "context": null,
      "examples": [],
      "input": "Problem:\n{problem}",
      "output_indicator": "Reason step by step, showing each intermediate step, then give the final answer on a line starting with 'Answer:'.",
      "variables": [
        { "name": "problem", "required": true, "description": "the problem to solve" }
      ],
      "output_format": "markdown",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["self-consistency", "add-fewshot", "format-enforce"],
      "source": "https://www.promptingguide.ai/techniques/cot",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "zs-cot-trigger",
      "version": "1.0.0",
      "technique": "zero-shot-cot",
      "domain": "reasoning",
      "instruction": "{question}",
      "context": null,
      "examples": [],
      "input": null,
      "output_indicator": "Let's think step by step.",
      "variables": [
        { "name": "question", "required": true, "description": "the question requiring reasoning" }
      ],
      "output_format": "markdown",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["self-consistency", "format-enforce"],
      "source": "https://www.promptingguide.ai/techniques/cot",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "self-consistency-vote",
      "version": "1.0.0",
      "technique": "self-consistency",
      "domain": "reasoning",
      "instruction": "Solve the problem using independent reasoning. This is sample {sample_index} of {n_samples}; reason freshly and do not assume any prior attempt.",
      "context": null,
      "examples": [],
      "input": "Problem:\n{problem}",
      "output_indicator": "Show reasoning, then output 'Answer:' followed by only the final value. (Caller runs this k times and takes the majority answer.)",
      "variables": [
        { "name": "problem", "required": true, "description": "problem to solve" },
        { "name": "sample_index", "required": false, "description": "index of this sample" },
        { "name": "n_samples", "required": false, "description": "total samples to draw" }
      ],
      "output_format": "markdown",
      "sampling_policy": "eval=100%",
      "composable_with": ["cot-stepwise"],
      "source": "https://www.promptingguide.ai/techniques/consistency",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "generate-knowledge",
      "version": "1.0.0",
      "technique": "generate-knowledge",
      "domain": "question-answering",
      "instruction": "First, generate {k} relevant facts about the topic in the question. Then use those facts to answer.",
      "context": null,
      "examples": [],
      "input": "Question:\n{question}",
      "output_indicator": "Output two sections: 'Knowledge:' (the facts) and 'Answer:' (the grounded answer).",
      "variables": [
        { "name": "question", "required": true, "description": "the question" },
        { "name": "k", "required": false, "description": "number of facts to generate; default 3-5" }
      ],
      "output_format": "markdown",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["prompt-chain-step", "self-critique"],
      "source": "https://www.promptingguide.ai/techniques/knowledge",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "rag-grounded-qa",
      "version": "1.0.0",
      "technique": "rag",
      "domain": "question-answering",
      "instruction": "Answer the question using ONLY the retrieved context below. If the answer is not in the context, say 'Not found in provided sources.'",
      "context": "Retrieved context:\n{retrieved_docs}",
      "examples": [],
      "input": "Question:\n{question}",
      "output_indicator": "Answer in prose. Cite the source id(s) in brackets after each claim, e.g. [doc_2].",
      "variables": [
        { "name": "retrieved_docs", "required": true, "description": "concatenated retrieved chunks with ids" },
        { "name": "question", "required": true, "description": "user question" }
      ],
      "output_format": "prose",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["self-critique", "format-enforce"],
      "source": "https://www.promptingguide.ai/techniques/rag",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "react-tool-loop",
      "version": "1.0.0",
      "technique": "react",
      "domain": "reasoning",
      "instruction": "Answer the question by interleaving reasoning and tool use. Available tools: {tools}.",
      "context": "Scratchpad so far:\n{scratchpad}",
      "examples": [],
      "input": "Question:\n{question}",
      "output_indicator": "Respond in repeating blocks: 'Thought:' (reasoning), 'Action:' (tool[input]), 'Observation:' (result). When done, output 'Final Answer:'.",
      "variables": [
        { "name": "question", "required": true, "description": "the question/task" },
        { "name": "tools", "required": true, "description": "list of available tools and signatures" },
        { "name": "scratchpad", "required": false, "description": "accumulated thought/action/observation history" }
      ],
      "output_format": "markdown",
      "sampling_policy": "eval=100%",
      "composable_with": ["reflexion-retry"],
      "source": "https://www.promptingguide.ai/techniques/react",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "reflexion-retry",
      "version": "1.0.0",
      "technique": "reflexion",
      "domain": "reasoning",
      "instruction": "Your previous attempt failed or was suboptimal. Reflect on why, then produce an improved attempt.",
      "context": "Previous attempt:\n{prior_attempt}\n\nFeedback / error signal:\n{feedback}",
      "examples": [],
      "input": "Original task:\n{task}",
      "output_indicator": "Output 'Reflection:' (what went wrong and the fix) then 'Revised attempt:'.",
      "variables": [
        { "name": "task", "required": true, "description": "original task" },
        { "name": "prior_attempt", "required": true, "description": "the previous output" },
        { "name": "feedback", "required": true, "description": "evaluator/test feedback" }
      ],
      "output_format": "markdown",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["react-tool-loop", "code-gen"],
      "source": "https://www.promptingguide.ai/techniques/reflexion",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "tot-branch-eval",
      "version": "1.0.0",
      "technique": "tree-of-thoughts",
      "domain": "reasoning",
      "instruction": "Explore {b} distinct partial solutions (thoughts) for the problem. Evaluate each as sure/maybe/impossible toward reaching the goal, then expand only the promising ones.",
      "context": "Current path:\n{path}",
      "examples": [],
      "input": "Problem:\n{problem}",
      "output_indicator": "Output a list of candidate thoughts each with an evaluation tag, then recommend which to expand next.",
      "variables": [
        { "name": "problem", "required": true, "description": "the problem" },
        { "name": "b", "required": false, "description": "branching factor; default 3" },
        { "name": "path", "required": false, "description": "thoughts chosen so far" }
      ],
      "output_format": "markdown",
      "sampling_policy": "eval=100%",
      "composable_with": ["self-consistency-vote"],
      "source": "https://www.promptingguide.ai/techniques/tot",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "meta-prompt-generate",
      "version": "1.0.0",
      "technique": "meta-prompting",
      "domain": "evaluation",
      "instruction": "Write a high-quality prompt for the task described below. The prompt must specify role, instruction, any needed context slots, and an explicit output format. Use {variable} syntax for inputs.",
      "context": null,
      "examples": [],
      "input": "Task to build a prompt for:\n{task_description}",
      "output_indicator": "Return only the generated prompt template, no commentary.",
      "variables": [
        { "name": "task_description", "required": true, "description": "what the target prompt should accomplish" }
      ],
      "output_format": "prose",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["self-critique", "format-enforce"],
      "source": "https://www.promptingguide.ai/techniques/meta-prompting",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "dsp-hint-steer",
      "version": "1.0.0",
      "technique": "dsp",
      "domain": "summarization",
      "instruction": "{instruction}",
      "context": "Steering hints (incorporate these keywords/angles): {hints}",
      "examples": [],
      "input": "Input:\n{input}",
      "output_indicator": "Produce the output, ensuring the hints are reflected.",
      "variables": [
        { "name": "instruction", "required": true, "description": "base task" },
        { "name": "hints", "required": true, "description": "directional keywords/stimulus to steer the output" },
        { "name": "input", "required": true, "description": "the content" }
      ],
      "output_format": "prose",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["format-enforce"],
      "source": "https://www.promptingguide.ai/techniques/dsp",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "extract-fields",
      "version": "1.0.0",
      "technique": "zero-shot",
      "domain": "information-extraction",
      "instruction": "Extract the specified fields from the text.",
      "context": "Target schema:\n{schema}",
      "examples": [],
      "input": "Text:\n{text}",
      "output_indicator": "Return ONLY valid JSON matching the schema. Use null for missing fields. No markdown fences.",
      "variables": [
        { "name": "schema", "required": true, "description": "field list or JSON schema" },
        { "name": "text", "required": true, "description": "source text" }
      ],
      "output_format": "json",
      "sampling_policy": "eval=100%",
      "composable_with": ["self-critique", "add-fewshot"],
      "source": "https://www.promptingguide.ai/prompts/information-extraction",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "classify-labeled",
      "version": "1.0.0",
      "technique": "zero-shot",
      "domain": "classification",
      "instruction": "Classify the input into exactly one label from the allowed set. Do not invent labels.",
      "context": "Allowed labels: {labels}",
      "examples": [],
      "input": "Input:\n{input}",
      "output_indicator": "Return only the label.",
      "variables": [
        { "name": "labels", "required": true, "description": "allowed label set" },
        { "name": "input", "required": true, "description": "item to classify" }
      ],
      "output_format": "enum",
      "sampling_policy": "eval=100%",
      "composable_with": ["add-fewshot", "add-cot"],
      "source": "https://www.promptingguide.ai/prompts/classification",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "code-gen",
      "version": "1.0.0",
      "technique": "zero-shot",
      "domain": "coding",
      "instruction": "Write code that satisfies the specification. Prefer clarity and handle edge cases.",
      "context": "Language/constraints: {constraints}",
      "examples": [],
      "input": "Specification:\n{spec}",
      "output_indicator": "Return only the code in a single fenced block, with brief inline comments.",
      "variables": [
        { "name": "spec", "required": true, "description": "what the code must do" },
        { "name": "constraints", "required": false, "description": "language, libs, perf constraints" }
      ],
      "output_format": "code",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["reflexion-retry", "self-critique"],
      "source": "https://www.promptingguide.ai/prompts/coding",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "summarize-concept",
      "version": "1.0.0",
      "technique": "zero-shot",
      "domain": "summarization",
      "instruction": "Explain the concept below to a {audience} in {n} sentences.",
      "context": null,
      "examples": [],
      "input": "Concept:\n{concept}",
      "output_indicator": "Plain prose, no jargon beyond what the audience knows.",
      "variables": [
        { "name": "concept", "required": true, "description": "concept to explain" },
        { "name": "audience", "required": true, "description": "target reader" },
        { "name": "n", "required": false, "description": "sentence budget; default 3" }
      ],
      "output_format": "prose",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["dsp-hint-steer", "format-enforce"],
      "source": "https://www.promptingguide.ai/prompts/text-summarization",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "check-hallucination",
      "version": "1.0.0",
      "technique": "zero-shot",
      "domain": "truthfulness",
      "instruction": "Determine whether the answer is supported by the provided context. Flag any claim not grounded in it.",
      "context": "Context:\n{context_docs}",
      "examples": [],
      "input": "Answer to check:\n{answer}",
      "output_indicator": "Return JSON: {\"supported\": bool, \"unsupported_claims\": [..]}. No prose.",
      "variables": [
        { "name": "context_docs", "required": true, "description": "ground-truth context" },
        { "name": "answer", "required": true, "description": "answer to verify" }
      ],
      "output_format": "json",
      "sampling_policy": "eval=100%",
      "composable_with": ["rag-grounded-qa"],
      "source": "https://www.promptingguide.ai/prompts/truthfulness",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "self-critique",
      "version": "1.0.0",
      "technique": "reflexion",
      "domain": "evaluation",
      "instruction": "Review the output below for errors, unsupported claims, and gaps against the original task. Then produce a corrected version.",
      "context": "Original task:\n{task}",
      "examples": [],
      "input": "Output to review:\n{output}",
      "output_indicator": "Return 'Issues:' then 'Revised:'.",
      "variables": [
        { "name": "task", "required": true, "description": "the original task" },
        { "name": "output", "required": true, "description": "output to critique" }
      ],
      "output_format": "markdown",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["ANY"],
      "is_wrapper": true,
      "source": "https://www.promptingguide.ai/techniques/reflexion",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "format-enforce",
      "version": "1.0.0",
      "technique": "zero-shot",
      "domain": "evaluation",
      "instruction": "Respond ONLY in the required format. No preamble, no explanation, no markdown fences.",
      "context": "Required format: {format}",
      "examples": [],
      "input": "Task:\n{task}",
      "output_indicator": "Output must validate against the required format.",
      "variables": [
        { "name": "format", "required": true, "description": "the strict output contract" },
        { "name": "task", "required": true, "description": "underlying task or upstream output" }
      ],
      "output_format": "variable",
      "sampling_policy": "eval=100%",
      "composable_with": ["ANY"],
      "is_wrapper": true,
      "source": "https://www.promptingguide.ai/introduction/elements",
      "owner": "platform",
      "status": "active"
    },
    {
      "id": "prompt-chain-step",
      "version": "1.0.0",
      "technique": "prompt-chaining",
      "domain": "question-answering",
      "instruction": "{step_instruction}",
      "context": "Output from previous step:\n{prev_output}",
      "examples": [],
      "input": "Original input:\n{input}",
      "output_indicator": "Produce only this step's output; it will be passed to the next step.",
      "variables": [
        { "name": "step_instruction", "required": true, "description": "what this chain step does" },
        { "name": "prev_output", "required": false, "description": "prior step output" },
        { "name": "input", "required": false, "description": "original input carried through" }
      ],
      "output_format": "prose",
      "sampling_policy": "runtime=sampled",
      "composable_with": ["ANY"],
      "is_wrapper": true,
      "source": "https://www.promptingguide.ai/techniques/prompt_chaining",
      "owner": "platform",
      "status": "active"
    }
  ]
}
