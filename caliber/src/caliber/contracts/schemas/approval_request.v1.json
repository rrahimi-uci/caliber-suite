{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliber.dev/schemas/approval_request.v1.json",
  "title": "ApprovalRequest: what an approver is asked to approve, bound to the exact intent",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "approval_request_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_hash": {
      "type": "string",
      "minLength": 1
    },
    "evidence_hash": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "minLength": 1
    },
    "expected_resource_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "risk_class": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)\\Z"
    },
    "allowed_responses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "approve",
          "reject",
          "request_changes"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "approval_request_id",
    "proposal_id",
    "intent_hash",
    "evidence_hash",
    "policy_digest",
    "expected_resource_version",
    "risk_class",
    "requested_by",
    "expires_at",
    "allowed_responses"
  ],
  "additionalProperties": false
}
