{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliber.dev/schemas/policy_decision.v1.json",
  "title": "PolicyDecision: the allow or deny that one action on one resource got",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)\\Z"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "grant_id",
    "action",
    "resource",
    "result",
    "reason_codes",
    "policy_version",
    "input_hash",
    "evaluated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "deny"
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
