{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliber.dev/schemas/receipt.v1.json",
  "title": "Receipt: what the downstream said about a performed effect",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "downstream_request_id": {
      "type": "string",
      "minLength": 1
    },
    "response_digest": {
      "type": "string",
      "minLength": 1
    },
    "verified_by": {
      "type": "string",
      "enum": [
        "query",
        "none"
      ]
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)\\Z"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "proposal_id",
    "downstream_request_id",
    "response_digest",
    "verified_by",
    "verified_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verified_by": {
            "const": "query"
          }
        }
      },
      "then": {
        "properties": {
          "verified_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verified_by": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "verified_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
