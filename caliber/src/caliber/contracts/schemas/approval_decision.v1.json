{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliber.dev/schemas/approval_decision.v1.json",
  "title": "ApprovalDecision: the answer to an approval request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "approval_request_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "request_changes"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)\\Z"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "approval_request_id",
    "decision",
    "decided_by",
    "decided_at",
    "reason"
  ],
  "additionalProperties": false
}
