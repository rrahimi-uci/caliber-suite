      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Two different stores are both called \"the artifact store.\"",
      "originalText": "Two different stores are both called \"the artifact store.\"",
      "fontSize": 7.0,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "lineHeight": 1.28,
      "containerId": null,
      "autoResize": true,
      "_anchorX": 170.0,
      "_bold": true,
      "_italic": false
    },
    {
      "id": "fig-topologies-text-38",
      "type": "text",
      "x": 10.06,
      "y": 257.56,
      "width": 319.87,
      "height": 17.92,
      "angle": 0,
      "strokeColor": "#1f2933",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 0.62,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2084311156,
      "version": 1,
      "versionNonce": 1338008660,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Support on one is not support on the other: reading MLflow's GCS support as CALIBER storage support is a\nconfiguration error waiting to happen.",
      "originalText": "Support on one is not support on the other: reading MLflow's GCS support as CALIBER storage support is a\nconfiguration error waiting to happen.",
      "fontSize": 7.0,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "lineHeight": 1.28,
      "containerId": null,
      "autoResize": true,
      "_anchorX": 170.0,
      "_bold": false,
      "_italic": false
    },
    {
      "id": "fig-topologies-text-39",
      "type": "text",
      "x": 19.82,
      "y": 285.48,
      "width": 300.36,
      "height": 8.96,
      "angle": 0,
      "strokeColor": "#1f2933",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 0.62,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 443779623,
      "version": 1,
      "versionNonce": 1844960774,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The API and the SPA are identical in both modes, so this is an operations decision, not a feature one.",
      "originalText": "The API and the SPA are identical in both modes, so this is an operations decision, not a feature one.",
      "fontSize": 7.0,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "lineHeight": 1.28,
      "containerId": null,
