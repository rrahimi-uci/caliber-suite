%% usenix-layout.sty -- USENIX ATC/OSDI camera-ready page layout.
%%
%% This reproduces the page geometry, type, and heading conventions of the
%% official USENIX conference template (usenix2019_v3.sty) using only packages
%% present in a TeX Live "basic" scheme. If you have the official style file,
%% drop it into this directory and swap the \usepackage line in main.tex --
%% the document body needs no changes.
%%
%% Layout per the USENIX author instructions:
%%   US letter, two columns, 10pt Times, 7.0in x 9.0in text block,
%%   0.33in column gutter, no page numbers on the camera-ready.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{usenix-layout}[2026/08/03 v1.0 USENIX-conformant layout]

% ---------------------------------------------------------------- options ----
%   [submission]  (default) numbered pages -- USENIX requires them for review
%   [cameraready]            no page numbers, per the camera-ready instructions
%   [anonymous]              suppress the author block for double-blind review
\newif\ifusenix@pagenumbers \usenix@pagenumberstrue
\newif\ifusenix@anon        \usenix@anonfalse
\DeclareOption{submission}{\usenix@pagenumberstrue}
\DeclareOption{cameraready}{\usenix@pagenumbersfalse}
\DeclareOption{pagenumbers}{\usenix@pagenumberstrue}
\DeclareOption{anonymous}{\usenix@anontrue}
\DeclareOption*{\PackageWarning{usenix-layout}{Unknown option '\CurrentOption'}}
\ProcessOptions\relax

% -------------------------------------------------------------- page body ----
\RequirePackage[letterpaper,textwidth=7.0in,textheight=9.0in,%
                centering,columnsep=0.33in]{geometry}

\ifusenix@pagenumbers
  \RequirePackage{fancyhdr}
  \pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{\normalfont\small\thepage}
\else
  \pagestyle{empty}
\fi

% ------------------------------------------------------------------- type ----
\RequirePackage{times}
\RequirePackage[T1]{fontenc}
\RequirePackage{textcomp}
\RequirePackage[protrusion=true,expansion=false]{microtype}

% Deliberately NOT mathptmx. Its virtual math fonts (zptmcm*) reference rsfs10,
% which the "rsfs" package supplies and a TeX Live basic scheme does not; the
% failure surfaces only at shipout, as an unloadable TFM. This paper's
% mathematics is confined to a handful of inline symbols, so Times text with
% Computer Modern math is the right trade. Prefer the text-mode separators in
% macros.tex (\dt, \arrowto) inside figures so no size-mismatched math glyph
% appears next to Times at \tiny. If you build with the rsfs fonts installed,
% adding \RequirePackage{mathptmx} here is safe.

% Both T1 and TS1 declare Computer Modern as their substitution family. On this
% install that resolves to Metafont-generated bitmaps (ec*/tc*), which get
% embedded as PK fonts and are a common camera-ready rejection. Point both
% substitutions at Times, which ships Type 1 outlines for T1 and TS1 alike, so
% any fallback stays vector.
\DeclareFontSubstitution{T1}{ptm}{m}{n}
\DeclareFontSubstitution{TS1}{ptm}{m}{n}

% times.sty points \ttfamily at Courier, which is both too wide for the dense
% inline identifiers this paper uses and absent in T1 metrics on a TeX Live
% "basic" install. Latin Modern Mono is narrower, ships T1 Type 1 outlines, and
% sits better next to Times at 10pt.
\renewcommand{\ttdefault}{lmtt}

% Same problem for \sffamily: times.sty points it at Helvetica, whose T1 metrics
% are likewise absent here, and a declared-but-unbuildable family defeats the
% substitution rules above (LaTeX only substitutes for a missing *shape*, not for
% a missing TFM). Latin Modern Sans ships T1 outlines.
\renewcommand{\sfdefault}{lmss}

% USENIX sets body text at 10pt on 12pt leading.
\renewcommand{\normalsize}{\@setfontsize\normalsize{10}{12}}
\normalsize

% ---------------------------------------------------------------- floating ----
% Systems papers are figure-dense; loosen LaTeX's conservative defaults so
% wide floats do not strand text.
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.7}
\renewcommand{\dbltopfraction}{0.9}
\renewcommand{\dblfloatpagefraction}{0.7}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}
\setcounter{dbltopnumber}{3}

% ---------------------------------------------------------------- headings ----
\RequirePackage[explicit]{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.6em}{#1}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{#1}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape}{\thesubsubsection}{0.6em}{#1}
\titlespacing*{\section}{0pt}{1.6ex plus .6ex minus .2ex}{0.9ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.2ex plus .5ex minus .2ex}{0.6ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{1.0ex plus .4ex minus .2ex}{0.4ex plus .2ex}
\setcounter{secnumdepth}{3}

% Run-in paragraph heading: the workhorse of a dense systems paper.
\newcommand{\para}[1]{\vspace{0.35ex}\noindent\textbf{#1}\hspace{0.6em}\ignorespaces}

% ------------------------------------------------------------------ title -----
% USENIX title block: title centered and large, authors centered beneath, no
% affiliation footnote machinery.
\renewcommand{\maketitle}{%
  \twocolumn[%
    \begin{@twocolumnfalse}%
      \begin{center}%
        {\LARGE\bfseries\@title\par}%
        \vspace{2.2ex}%
        \ifusenix@anon
          {\normalsize\itshape Paper \#\,---\ submitted for double-blind
           review\par}%
        \else
          {\normalsize\@author\par}%
        \fi
      \end{center}%
      \vspace{2.8ex}%
    \end{@twocolumnfalse}%
  ]%
  \thispagestyle{\ifusenix@pagenumbers fancy\else empty\fi}%
}

% USENIX abstracts span the full text width above the two columns; we keep the
% conventional single-column abstract used by ATC/OSDI submissions instead,
% since it reads better with a long structured abstract.
\renewenvironment{abstract}{%
  \section*{Abstract}\normalsize
}{\par}

% ------------------------------------------------------------- bibliography ---
% Tight, USENIX-style numeric reference list with compressed citation ranges.
\RequirePackage[numbers,sort&compress]{natbib}
\renewcommand{\@biblabel}[1]{[#1]}
\setlength{\bibsep}{0.55ex plus 0.2ex}
\renewcommand{\bibfont}{\small}

\endinput
