\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{forloop}[2026/08/10 Minimal forloop package]

\RequirePackage{ifthen}

\newcommand{\forloop}[4]{%
  \setcounter{#1}{#2}%
  \forloop@aux{#1}{#3}{#4}%
}

\newcommand{\forloop@aux}[3]{%
  \ifthenelse{#2}{%
    #3%
    \addtocounter{#1}{1}%
    \forloop@aux{#1}{#2}{#3}%
  }{}%
}
