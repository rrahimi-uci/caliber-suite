# Export these in the cron host's environment; never commit credentials.
AUTOCD_CONFIG=/absolute/path/to/private/workflow.toml
AUTOCD_REPO_ROOT=/absolute/path/to/caliber-suite
AUTOCD_STATE_DIR=/absolute/path/to/private/persistent/state
AUTOCD_ENABLED=false
AUTOCD_DAILY_TIME=09:00
AUTOCD_TIMEZONE=America/Los_Angeles
AUTOCD_REPOSITORY=rrahimi-uci/caliber-suite
AUTOCD_BASE_BRANCH=main
AUTOCD_MODEL=sonnet
AUTOCD_EFFORT=high
