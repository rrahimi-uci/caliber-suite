# Infra stack config — copy to deploy/.env and edit as needed.
# These feed the docker-compose service definitions under deploy/.
# (Application env — CALIBER_*, MLFLOW_* — lives in the suite-root .env.)

# ── MinIO ───────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Buckets created on first boot by the `createbuckets` job.
# MLflow run artifacts land at s3://mlflow/mlruns/<exp>/<run>/artifacts/
# (the artifact root is set in the suite-root .env / mlflow compose).
MINIO_MLFLOW_BUCKET=mlflow
MINIO_WORKSPACES_BUCKET=caliber-workspaces
MINIO_LOG_BUCKET=caliber-log

# ── Adminer (Postgres web UI) ───────────────────────────────────────────
ADMINER_PORT=8081

# ── AGE Viewer (graph DB console) ───────────────────────────────────────
AGE_VIEWER_PORT=8082

# ── App tier host ports (optional, --profile app) ──────────────────────
# MLflow defaults to 5000. ./start.sh automatically selects the next free
# port when 5000 is occupied, unless MLFLOW_PORT is set explicitly.
# MLFLOW_PORT=5000
# CALIBER_PORT=5001
# MLFLOW_GATEWAY_PORT=5002

# ── NATS (optional, --profile nats) ─────────────────────────────────────
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
